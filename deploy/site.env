# Открытые (не секретные) настройки выкладки. Секреты сюда не писать: они в GitHub Secrets.
DEPLOY_HOST=185.113.132.82
NEXT_PUBLIC_SITE_URL=https://myopora.kz
# Публичный ключ базы: он и так виден в браузере каждому посетителю.
NEXT_PUBLIC_SUPABASE_URL=https://myopora.kz
NEXT_PUBLIC_SUPABASE_ANON_KEY=server

# Письма входа (подтверждение почты, новый пароль) уходят через Resend. Ключ — секрет RESEND_API_KEY.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_ADMIN_EMAIL=noreply@myopora.kz
# Отправитель писем приглашений и (когда включат DAILY_EMAILS=on) писем дня
EMAIL_FROM=Опора <noreply@myopora.kz>
OLD_URL=https://tjvavsizvmjoaieankmy.supabase.co

# ИИ-аналитика для психологов. Включена, потому что у ключа GEMINI_API_KEY подключена оплата
# (платный тариф Gemini API: Google не обучает модели на этих данных). Если оплату отключат, поставьте off.
AI_ANALYTICS=on

# Голос в «Комнатах» (LiveKit на этом же сервере). Ключи LIVEKIT_API_KEY/SECRET создаются на сервере сами.
LIVEKIT_URL=wss://myopora.kz
LIVEKIT_API_URL=http://livekit:7880
