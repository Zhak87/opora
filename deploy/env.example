# Необязательный секрет PROD_ENV в GitHub: дополнительные настройки сайта, по одной на строку.

# Значения метатегов для подтверждения прав в Google Search Console и Яндекс Вебмастере.
# GOOGLE_SITE_VERIFICATION=
# YANDEX_SITE_VERIFICATION=
# Адрес сайта, IP и публичный ключ базы уже в deploy/site.env, ключ ИИ — в секрете GEMINI_API_KEY,
# CRON_SECRET создаётся на сервере сам. Сюда — только то, что нужно включить дополнительно, например:

# Юридические данные для /privacy и /terms
OPORA_OPERATOR=
OPORA_CONTACT_EMAIL=

# Письма дня (Resend)
RESEND_API_KEY=
EMAIL_FROM=
DAILY_EMAILS=
