# Содержимое секрета PROD_ENV в GitHub (Settings → Secrets and variables → Actions → New repository secret).
# При каждой выкладке он записывается на сервер в /opt/opora/.env. Значения те же, что сейчас в Vercel.

# Адрес сайта и почта для бесплатного SSL (Let's Encrypt пишет сюда, если что-то не так с сертификатом)
DOMAIN=opora.kz
ACME_EMAIL=
NEXT_PUBLIC_SITE_URL=https://opora.kz

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tjvavsizvmjoaieankmy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ИИ
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
AI_ANALYTICS=

# Юридические данные для /privacy и /terms
OPORA_OPERATOR=
OPORA_CONTACT_EMAIL=

# Письма и задачи по расписанию (на сервере их запускает контейнер cron в 08:00 по Астане)
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
DAILY_EMAILS=
