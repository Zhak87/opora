# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tjvavsizvmjoaieankmy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Адрес сайта (например https://opora.vercel.app). Нужен для ссылок в письмах.
NEXT_PUBLIC_SITE_URL=

# ИИ-собеседник. По умолчанию Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Основная и запасная модели через запятую
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Либо любой OpenAI-совместимый сервис (например OpenRouter с бесплатной моделью):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
