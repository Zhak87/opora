# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tjvavsizvmjoaieankmy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Адрес сайта (например https://opora.vercel.app). Нужен для ссылок в письмах.
NEXT_PUBLIC_SITE_URL=

# ИИ-собеседник. По умолчанию Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# По умолчанию разговор начинает с Flash-Lite. Задайте свой порядок моделей через запятую:
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# Собеседник просит модель не «размышлять» долго, чтобы первые слова приходили быстрее. Вернуть как было: off
# AI_FAST_THINKING=off

# Либо любой OpenAI-совместимый сервис (например OpenRouter с бесплатной моделью):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ИИ-аналитика для психологов. Включайте (on) только когда провайдер не обучается на данных:
# платный тариф Gemini или OpenAI-совместимый сервис с отказом от обучения. Бесплатный Gemini для этого не подходит.
AI_ANALYTICS=

# Юридические данные для страниц /privacy и /terms: кто оператор персональных данных и как с ним связаться.
# Например: OPORA_OPERATOR=ИП Иванов И. И., ИИН 000000000000, г. Алматы
OPORA_OPERATOR=
OPORA_CONTACT_EMAIL=

# Письмо дня курса «Мой путь» (необязательно). Пока DAILY_EMAILS не равно on, рассылка только считает письма.
# Ключ Resend (бесплатно 100 писем в день): https://resend.com/api-keys
RESEND_API_KEY=
# Отправитель с подтверждённого в Resend домена, например: Опора <hello@opora.kz>
EMAIL_FROM=
# Секрет для запуска рассылки по расписанию (Vercel Cron передаёт его сам) и подписи ссылок отписки
CRON_SECRET=

# Web Push. Создать пару локально: npx web-push generate-vapid-keys
# При выкладке на свой сервер ключи создаются автоматически.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# HTTPS-адрес сайта или mailto: адрес оператора (по умолчанию NEXT_PUBLIC_SITE_URL).
WEB_PUSH_SUBJECT=
# Служебный ключ Supabase (Project Settings → API Keys → service_role / secret). Только на сервере!
SUPABASE_SERVICE_ROLE_KEY=
# on — отправлять письма по-настоящему
DAILY_EMAILS=

# Пробный доступ без регистрации: сколько минут даётся гостю (по умолчанию 20)
# TRIAL_MINUTES=20
